# Font
font-family = FiraCode Nerd Font Mono
font-size = 14
font-thicken

initial-window = false
macos-hidden = always

# Finestra
window-padding-x = 10
window-padding-y = 10
macos-titlebar-style = transparent
window-theme = auto
window-colorspace = display-p3

# Tema (si adatta a light/dark mode automaticamente)
theme = Carbonfox

# Comportamento
background-opacity = 1
background-blur-radius = 20
scrollback-limit = 10000
mouse-hide-while-typing = true
confirm-close-surface = false
term = xterm-256color

# Shell integration
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# --- KEYBINDINGS ---

# Quick terminal globale (accessibile anche quando Ghostty non è in focus)
keybind = global:cmd+backslash=toggle_quick_terminal

# Nuova finestra / tab
keybind = cmd+n=new_window
keybind = cmd+t=new_tab

# Split verticale e orizzontale
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=new_split:auto

# Navigazione split in stile Vim
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:down
keybind = cmd+k=goto_split:up
keybind = cmd+l=goto_split:right

# Zoom split corrente
keybind = cmd+shift+z=toggle_split_zoom

# macOS option come alt (utile per shell e editor)
macos-option-as-alt = true